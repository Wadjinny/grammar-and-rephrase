# GEMINI_API_KEY: Gemini is the last fallback for grammar check and rephrase.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Grammar check and rephrase try Cerebras, then Groq, then Gemini. A missing key just skips that provider.
CEREBRAS_API_KEY=""
GROQ_API_KEY=""

# PocketBase URL used to verify user auth tokens (no trailing slash).
PB_URL="https://db.w-ilyas.site"
